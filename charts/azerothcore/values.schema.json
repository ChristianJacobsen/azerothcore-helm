{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "AzerothCore chart values",
  "type": "object",
  "properties": {
    "flavor": {
      "type": "string",
      "enum": [
        "vanilla",
        "playerbots"
      ]
    },
    "imagePullSecrets": {
      "type": "array"
    },
    "imagePullPolicy": {
      "type": "string",
      "enum": [
        "Always",
        "IfNotPresent",
        "Never"
      ]
    },
    "images": {
      "type": "object",
      "properties": {
        "vanilla": {
          "$ref": "#/definitions/flavorImages"
        },
        "playerbots": {
          "$ref": "#/definitions/flavorImages"
        },
        "kubectl": {
          "$ref": "#/definitions/image"
        },
        "python": {
          "$ref": "#/definitions/image"
        }
      }
    },
    "database": {
      "type": "object",
      "properties": {
        "user": {
          "type": "string",
          "minLength": 1
        },
        "password": {
          "type": "string"
        },
        "existingSecret": {
          "type": "string"
        },
        "names": {
          "type": "object",
          "properties": {
            "auth": {
              "type": "string",
              "minLength": 1
            },
            "world": {
              "type": "string",
              "minLength": 1
            },
            "characters": {
              "type": "string",
              "minLength": 1
            },
            "playerbots": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "mysql": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "image": {
          "$ref": "#/definitions/image"
        },
        "rootPassword": {
          "type": "string"
        },
        "extraArgs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "externalDatabase": {
      "type": "object",
      "properties": {
        "host": {
          "type": "string"
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "adminUser": {
          "type": "string"
        }
      }
    },
    "clientData": {
      "type": "object",
      "properties": {
        "volume": {
          "type": "object"
        },
        "existingClaim": {
          "type": "string"
        },
        "source": {
          "type": "string",
          "enum": [
            "download",
            "none"
          ]
        },
        "storage": {
          "type": "object",
          "properties": {
            "size": {
              "type": "string"
            },
            "storageClass": {
              "type": "string"
            },
            "accessModes": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "dbInit": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "realm": {
          "type": "object",
          "properties": {
            "id": {
              "type": "integer",
              "minimum": 1
            },
            "name": {
              "type": "string"
            },
            "address": {
              "type": "string"
            },
            "port": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1,
              "maximum": 65535
            }
          }
        },
        "accounts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "username": {
                "type": "string",
                "minLength": 1,
                "maxLength": 17
              },
              "password": {
                "type": "string",
                "maxLength": 16
              },
              "existingSecret": {
                "type": "string"
              },
              "passwordKey": {
                "type": "string"
              },
              "gmlevel": {
                "type": "integer",
                "minimum": 0,
                "maximum": 3
              }
            },
            "required": [
              "username"
            ]
          }
        }
      }
    },
    "authserver": {
      "$ref": "#/definitions/server"
    },
    "worldserver": {
      "$ref": "#/definitions/server"
    },
    "gateway": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "parentRefs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "namespace": {
                "type": "string"
              },
              "sectionName": {
                "type": "string"
              }
            },
            "required": [
              "name"
            ]
          }
        },
        "annotations": {
          "type": "object"
        }
      }
    },
    "nameOverride": {
      "type": "string"
    },
    "fullnameOverride": {
      "type": "string"
    },
    "podAnnotations": {
      "type": "object"
    },
    "podLabels": {
      "type": "object"
    }
  },
  "definitions": {
    "server": {
      "type": "object",
      "properties": {
        "config": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "string",
              "integer",
              "number"
            ],
            "description": "AzerothCore conf key (verbatim from .dist) \u2192 value. Use 1/0, not true/false."
          }
        },
        "extraEnv": {
          "type": "array"
        },
        "service": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "ClusterIP",
                "NodePort",
                "LoadBalancer"
              ]
            },
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "nodePort": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 30000,
              "maximum": 32767
            },
            "annotations": {
              "type": "object"
            },
            "externalTrafficPolicy": {
              "type": "string",
              "enum": [
                "",
                "Cluster",
                "Local"
              ]
            }
          }
        },
        "resources": {
          "type": "object"
        }
      }
    },
    "image": {
      "type": "object",
      "properties": {
        "registry": {
          "type": "string"
        },
        "repository": {
          "type": "string"
        },
        "tag": {
          "type": "string"
        },
        "digest": {
          "type": "string"
        }
      }
    },
    "flavorImages": {
      "type": "object",
      "properties": {
        "worldserver": {
          "$ref": "#/definitions/image"
        },
        "authserver": {
          "$ref": "#/definitions/image"
        },
        "dbImport": {
          "$ref": "#/definitions/image"
        },
        "clientData": {
          "$ref": "#/definitions/image"
        }
      }
    }
  }
}
