{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "AzerothCore chart values",
  "type": "object",
  "properties": {
    "flavor": {
      "type": "string",
      "enum": ["vanilla", "playerbots"],
      "description": "Base image flavor. Non-vanilla flavors require flavorRegistry or explicit images.* overrides."
    },
    "flavorRegistry": { "type": "string" },
    "imagePullSecrets": { "type": "array" },
    "imagePullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] },
    "images": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "registry": { "type": "string" },
          "repository": { "type": "string", "minLength": 1 },
          "tag": { "type": "string", "minLength": 1 },
          "digest": { "type": "string" }
        },
        "required": ["repository"]
      }
    },
    "mysql": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "rootPassword": { "type": "string" },
        "existingSecret": { "type": "string" },
        "existingSecretPasswordKey": { "type": "string" }
      }
    },
    "externalDatabase": {
      "type": "object",
      "properties": {
        "host": { "type": "string" },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "user": { "type": "string" },
        "existingSecret": { "type": "string" },
        "existingSecretPasswordKey": { "type": "string" }
      }
    },
    "clientData": {
      "type": "object",
      "properties": {
        "download": { "type": "boolean" },
        "existingClaim": { "type": "string" }
      }
    },
    "dbInit": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "realm": {
          "type": "object",
          "properties": {
            "address": { "type": "string" },
            "name": { "type": "string" }
          }
        }
      }
    },
    "authserver": { "$ref": "#/definitions/server" },
    "worldserver": { "$ref": "#/definitions/server" },
    "gateway": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "parentRefs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "namespace": { "type": "string" },
              "sectionName": { "type": "string" }
            },
            "required": ["name"]
          }
        },
        "annotations": { "type": "object" }
      }
    },
    "nameOverride": { "type": "string" },
    "fullnameOverride": { "type": "string" },
    "podAnnotations": { "type": "object" },
    "podLabels": { "type": "object" }
  },
  "definitions": {
    "server": {
      "type": "object",
      "properties": {
        "config": {
          "type": "object",
          "additionalProperties": {
            "type": ["string", "integer", "number"],
            "description": "AzerothCore conf key (verbatim from .dist) → value. Use 1/0, not true/false."
          }
        },
        "extraEnv": { "type": "array" },
        "service": {
          "type": "object",
          "properties": {
            "type": { "type": "string", "enum": ["ClusterIP", "NodePort", "LoadBalancer"] },
            "port": { "type": "integer" },
            "nodePort": { "type": ["integer", "null"], "minimum": 30000, "maximum": 32767 },
            "annotations": { "type": "object" }
          }
        },
        "resources": { "type": "object" }
      }
    }
  }
}
